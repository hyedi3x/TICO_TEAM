<?xml version="1.0" encoding="UTF-8"?>
<!--https://maven.apache.org/xsd/maven-4.0.0.xsd에서 http로 변경 -->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
   xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
   <modelVersion>4.0.0</modelVersion>
   <parent>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-parent</artifactId>
      <version>2.7.4</version>   <!-- 3.4.3 (default version, downgrade)-->
      <relativePath/> <!-- lookup parent from repository -->
   </parent>
   <groupId>com.example</groupId>
   <artifactId>TICO</artifactId>
   <version>0.0.1-SNAPSHOT</version>
   <name>TICO</name>
   <description>Demo project for Spring Boot</description>
   <url/>
   <licenses>
      <license/>
   </licenses>
   <developers>
      <developer/>
   </developers>
   <scm>
      <connection/>
      <developerConnection/>
      <tag/>
      <url/>
   </scm>
   
   <!-- 아임포트 repositories 추가 -->
  <repositories>
    <repository>
      <id>jitpack.io</id>
      <url>https://jitpack.io</url>
    </repository>
  </repositories>
  
   <properties>
      <java.version>17</java.version>
   </properties>
   <dependencies>
      <!-- JPA -->
      <dependency>
         <groupId>org.springframework.boot</groupId>
         <artifactId>spring-boot-starter-data-jpa</artifactId>
      </dependency>
      
      <!-- spring web -->
      <dependency>
         <groupId>org.springframework.boot</groupId>
         <artifactId>spring-boot-starter-web</artifactId>
      </dependency>
      
      <!-- 3.0.4 (default version, downgrade -->
      <dependency>
         <groupId>org.mybatis.spring.boot</groupId>
         <artifactId>mybatis-spring-boot-starter</artifactId>
         <version>2.3.1</version>
      </dependency>

      <!-- devtools-->
      <dependency>
         <groupId>org.springframework.boot</groupId>
         <artifactId>spring-boot-devtools</artifactId>
         <scope>runtime</scope>
         <optional>true</optional>
      </dependency>
      
      <!-- Lombok -->
      <dependency>
          <groupId>org.projectlombok</groupId>
          <artifactId>lombok</artifactId>
          <optional>true</optional>
      </dependency>
      
	  <!-- social login OAuth2 + JWT 사용 dependency -->   
      <!-- Spring Boot Security -->
       <dependency>
          <groupId>org.springframework.boot</groupId>
          <artifactId>spring-boot-starter-security</artifactId>
      </dependency>
    
      <!-- OAuth2 Client -->
      <dependency>
          <groupId>org.springframework.boot</groupId>
          <artifactId>spring-boot-starter-oauth2-client</artifactId>
      </dependency>
    
      <!-- JWT (jjwt) -->
     <dependency> <!-- JWT의 핵심 API를 제공 -->
         <groupId>io.jsonwebtoken</groupId>
         <artifactId>jjwt-api</artifactId>
         <version>0.11.5</version>
     </dependency>
     
     <dependency> <!-- 구현체로, 런타임에 필요 -->
         <groupId>io.jsonwebtoken</groupId>
         <artifactId>jjwt-impl</artifactId>
         <version>0.11.5</version>
         <scope>runtime</scope>
     </dependency>
     
     <dependency> <!-- Jackson을 사용해 JWT의 클레임(claims)을 JSON으로 처리 -->
         <groupId>io.jsonwebtoken</groupId>
         <artifactId>jjwt-jackson</artifactId>
         <version>0.11.5</version>
         <scope>runtime</scope>
     </dependency>
     
     <!-- H2 Database (테스트용, 실제 DB로 교체 가능) -->
     <!-- yml 파일에 h2 추가 -->
     <dependency>
         <groupId>com.h2database</groupId>
         <artifactId>h2</artifactId>
         <scope>runtime</scope>
     </dependency>
    
      <!-- MariaDB Driver -->
      <dependency>
          <groupId>org.mariadb.jdbc</groupId>
          <artifactId>mariadb-java-client</artifactId>
          <scope>runtime</scope>
      </dependency>
      
      <!-- JavaMailSender 메일발송을 위해 추가 -->
      <dependency>
	      <groupId>org.springframework.boot</groupId>
	      <artifactId>spring-boot-starter-mail</artifactId>
	  </dependency>
	  
	  <!-- 채팅 WebSocket 지원 -->
 	  <dependency>
   		  <groupId>org.springframework.boot</groupId>
    	  <artifactId>spring-boot-starter-websocket</artifactId>
  	  </dependency>
      
      <!-- CoolSMS 사용위해 의존성 추가 -->
      <dependency>
	      <groupId>net.nurigo</groupId>
	      <artifactId>sdk</artifactId>
	      <version>4.3.0</version>
	  </dependency>
	  
	  <!-- 아임포트 라이브러리 추가 -->
	   <dependency>
	      <groupId>com.github.iamport</groupId>
	      <artifactId>iamport-rest-client-java</artifactId>
	      <version>0.2.23</version>
	   </dependency>
	   
	   <!-- Apache POI 엑셀 파일 변환 -->
		<dependency>
		    <groupId>org.apache.poi</groupId>
		    <artifactId>poi</artifactId>
		    <version>5.2.3</version> <!-- 2024년 안정 버전 -->
		</dependency>

		<dependency>
		    <groupId>org.apache.poi</groupId>
		    <artifactId>poi-ooxml</artifactId>
		    <version>5.2.3</version>
		</dependency>
      
      <!-- done -->
      <dependency>
         <groupId>org.springframework.boot</groupId>
         <artifactId>spring-boot-starter-test</artifactId>
         <scope>test</scope>
      </dependency>
      <dependency>
         <groupId>org.mybatis.spring.boot</groupId>
         <artifactId>mybatis-spring-boot-starter-test</artifactId>
         <version>3.0.4</version>
         <scope>test</scope>
      </dependency>
   </dependencies>

   <build>
      <plugins>
         <plugin>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-maven-plugin</artifactId>
         </plugin>
      </plugins>
   </build>

</project>